diff --git a/.env.example b/.env.example
new file mode 100644
index 0000000..e3e84c7
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,9 @@
+# Firebase config used by src/firebase.ts and src/React/LikeButton.tsx
+# IMPORTANT: all of these must be prefixed with PUBLIC_ because Astro only
+# exposes PUBLIC_-prefixed env vars to client-side (browser) code.
+PUBLIC_FIREBASE_API_KEY=
+PUBLIC_FIREBASE_AUTH_DOMAIN=
+PUBLIC_FIREBASE_PROJECT_ID=
+PUBLIC_FIREBASE_STORAGE_BUCKET=
+PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
+PUBLIC_FIREBASE_APP_ID=
diff --git a/.github/dependabot.yml b/.github/dependabot.yml
index ee2c53b..e8aa2dd 100644
--- a/.github/dependabot.yml
+++ b/.github/dependabot.yml
@@ -5,7 +5,13 @@ updates:
     schedule:
       interval: "weekly"
     groups:
-      # Group all the updates in a single PR
+      # Group all the updates in a single PR, except sensitive packages
+      # (typescript/astro) that get their own PR for manual review, since
+      # major bumps there have broken `astro check` in the past.
       all-dependencies:
         patterns:
           - "*"
+        exclude-patterns:
+          - "typescript"
+          - "astro"
+          - "@astrojs/*"
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000..5e8f9c9
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,28 @@
+name: CI
+
+on:
+  pull_request:
+  push:
+    branches: [main]
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Setup pnpm
+        uses: pnpm/action-setup@v4
+
+      - name: Setup Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: 20
+          cache: pnpm
+
+      - name: Install dependencies
+        run: pnpm install --frozen-lockfile
+
+      - name: Type-check & build
+        run: pnpm run build
